# Server configuration
# Heroku assigns the port at runtime; the app must use whatever it is given.
# This value is only used locally.
PORT=3000

# Database configuration
#
# Managed Postgres (Heroku, Neon, Railway) provides a single connection string.
# When DATABASE_URL is set it wins and the DB_* values below are ignored.
# Heroku sets this for you when you attach a Postgres add-on -- do not set it
# there by hand, and never commit a real one.
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# Local development uses these instead.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workout_tracker
DB_USER=postgres
DB_PASSWORD=your-db-password

# SSL is enabled automatically when DATABASE_URL is set, and off otherwise.
# Only set this to override that (e.g. a local server that does have SSL).
# PGSSL=true

# Authentication and CORS
JWT_SECRET=replace-with-long-random-secret
# Access token lifetime. Short by design; the refresh token maintains the session.
JWT_EXPIRES_IN=15m
JWT_ISSUER=workout-tracker-api
JWT_AUDIENCE=workout-tracker-mobile
# Comma-separated list of allowed origins. Defaults to "*" when unset, which is
# fine for a mobile app but should be narrowed if a web client is ever added.
CORS_ORIGIN=http://localhost:8081

# Auth rate limiting (per IP). Defaults shown; all optional.
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Failed logins allowed per window (successful logins are not counted)
LOGIN_RATE_LIMIT_MAX=10
# Accounts that can be created per window
REGISTER_RATE_LIMIT_MAX=5
# Refresh calls allowed per window
REFRESH_RATE_LIMIT_MAX=60

# How long a refresh token stays valid (days)
REFRESH_TOKEN_TTL_DAYS=60
